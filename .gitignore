.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv*/
*.egg-info/

# Market data and generated/release artifacts are governed by their own
# manifests and must never be copied into source control.
data/
inputs/
outputs/
reports/
artifacts/
archive/

# Oversized or non-runtime research ledgers remain locally hash-bound evidence.
# They require Git LFS or an immutable artifact-store receipt rather than
# ordinary Git. Compact manifests/results retain their path, row count, byte
# count, and SHA-256 identity. The three small final Phase-6 ledgers are
# explicitly portable because the Phase-7 readiness audit verifies them.
experiments/results/*.jsonl
!experiments/results/smc_semantics_v1_2_2024_06_phase6_mbo_week2_extension_v3.episodes.jsonl
!experiments/results/smc_semantics_v1_2_2024_06_phase6_mbo_week2_extension_v3.matched_pairs.jsonl
!experiments/results/smc_semantics_v1_2_2024_06_phase6_mbo_week2_extension_v3.unmatched.jsonl

# coverage artefacts
.coverage
.coverage.*

# macOS/iCloud sync duplicates ("observation 2.py", "registry_v1_3 2.yaml").
# The Desktop is iCloud-synced, so conflicting saves land as " 2" siblings that
# are byte-identical to the original and belong to no commit.
* 2.*
