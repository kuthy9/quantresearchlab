.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv*/
*.egg-info/

# Market data and generated/release artifacts are governed by their own
# manifests and must never be copied into source control.
data/
inputs/
outputs/
reports/
artifacts/
archive/

# Research runs write under outputs/, which is already ignored above. The
# frozen experiments/ tree of v1.2-era manifests and result ledgers was retired
# on 2026-09-06; the four runner templates it still needed moved to
# configs/research/ and are tracked.

# coverage artefacts
.coverage
.coverage.*

# macOS/iCloud sync duplicates ("observation 2.py", "registry_v1_3 2.yaml").
# The Desktop is iCloud-synced, so conflicting saves land as " 2" siblings that
# are byte-identical to the original and belong to no commit.
* 2.*
