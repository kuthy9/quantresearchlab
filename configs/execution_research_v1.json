{
  "schema_version": "phase8_execution_research_v1.1",
  "model_version": "minute_bbo_mbo_proxy_ohlc_adverse_first_v2",
  "status": "development_unvalidated",
  "authority": "research_only_never_submit",
  "ordered_methods": [
    "market",
    "fvg_50_limit",
    "ob_50_limit",
    "reclaim_limit",
    "breakout_limit",
    "aggressive_limit",
    "passive_limit"
  ],
  "market_comparator": "market",
  "tick_size": 0.25,
  "point_value": 20.0,
  "commission_per_contract_per_side": 2.25,
  "maximum_book_age_seconds": 60.0,
  "clock_step_seconds": 60,
  "maximum_quantity": 100,
  "realized_spread_horizon_seconds": 300,
  "clock_model": {
    "entry_gtt_field": "expires_at_compatibility_alias_for_entry_expires_at",
    "analysis_end_field": "analysis_ends_at",
    "default_analysis_end": "entry_expires_at_for_legacy_callers",
    "post_gtt_policy": "existing_position_stop_target_and_observation_continue;new_entry_fills_forbidden"
  },
  "fill_model": {
    "market": "first_causal_valid_BBO;displayed_best_size_whole_contract_floor_only;unknown_remainder_censored",
    "marketable_limit": "causal_BBO_at_or_after_intent;fill_at_best_quote_not_better_than_limit;displayed_best_size_whole_contract_floor_only",
    "resting_limit": "completed_OHLC_touch_plus_whole_contract_floor_of_same_side_passive_F_volume_as_fill_capacity_proxy",
    "partial": "remaining_quantity_stays_working_until_fill_cancel_expiry_or_censor",
    "partial_position_clock_order": "existing_exposure_resolves_completed_bar_stop_first_then_remainder_cancelled_before_end_clock_quote_or_resting_proxy_fill",
    "contract_binding": "logical_to_vendor_instrument_mapping_id_and_sha256_exact;vendor_id_equals_OHLCV_and_Phase6;intent_tick_size_and_point_value_must_equal_frozen_protocol",
    "displayed_defense": "same_side_displayed_add_minus_cancel_nonnegative_proxy_only_not_queue_position",
    "same_bar": "adverse_first;stop_charged;target_not_credited_when_new_fill_depends_on_same_completed_bar",
    "price_improvement": "none_for_non_marketable_limit",
    "queue_truth_available": false
  },
  "censor_policy": {
    "reasons": [
      "missing_clock",
      "missing_top_of_book",
      "invalid_top_of_book",
      "crossed_top_of_book",
      "stale_top_of_book",
      "reset_source",
      "synthetic_source",
      "missing_mbo_mechanism",
      "fractional_contract_capacity"
    ],
    "invalid_source_is_unfilled": false,
    "silent_fallback_allowed": false
  },
  "metric_definitions": {
    "implementation_shortfall_points": "side_sign*(average_fill-arrival_mid)+entry_commission_points",
    "slippage_points": "side_sign*(average_fill-method_reference_price)",
    "realized_spread_points": "2*side_sign*(average_fill-horizon_mid);positive_is_cost_to_trader",
    "adverse_selection_points": "max(0,side_sign*(average_fill-horizon_mid))",
    "missed_opportunity_points": "unfilled_fraction*max(0,side_sign*(terminal_mid-arrival_mid))",
    "mae_mfe": "post_first_fill_OHLC_points;new_fill_bar_has_adverse_credit_only",
    "target_before_invalidation": "after_first_fill;adverse_first_on_same_bar"
  },
  "inference": {
    "unit": "research_intent_id",
    "pairing": "same_intent_all_methods_no_cross_intent_matching",
    "primary_metric": "implementation_shortfall_points",
    "primary_pair_availability": "both_full_fill_and_primary_metric_non_null_ignore_secondary_metric_censors",
    "contrasts": "each_non_market_method_minus_market",
    "test": "two_sided_exact_sign_test",
    "multiplicity": "holm_across_six_fixed_contrasts",
    "minimum_complete_pairs": 30,
    "cross_intent_independence_claimed": false,
    "confirmatory_claim": false,
    "tuning": false
  }
}
